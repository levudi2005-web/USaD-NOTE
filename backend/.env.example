# NOTE Backend Configuration Template (.env.example)

APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=note_db
DB_USER=note_app
DB_PASSWORD=replace_with_a_long_random_password
MARIADB_ROOT_PASSWORD=replace_with_a_different_long_random_password

STORAGE_ROOT=../storage
APP_SECRET=replace_with_a_random_secret_at_least_32_characters
AI_ENCRYPTION_KEY=replace_with_64_hexadecimal_characters
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MAX_UPLOAD_BYTES=104857600
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
MAX_ARCHIVE_COMPRESSION_RATIO=50
