{
  "name": "note-workspace",
  "version": "1.0.0",
  "description": "NOTE - không gian tri thức cá nhân, tài liệu và học tập",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "note",
    "knowledge-management",
    "documents",
    "ai"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check . && node scripts/check-icons.mjs",
    "test:documents": "node --test tests/document-readers.test.mjs",
    "test:sharing": "node --test tests/public-sharing-security.test.mjs tests/api-sharing.test.mjs",
    "format": "prettier --write ."
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 114",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@supabase/supabase-js": "2.119.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "bootstrap": "5.3.8",
    "dompurify": "3.4.17",
    "epubjs": "0.3.93",
    "fast-xml-parser": "5.12.0",
    "jszip": "3.10.2",
    "lucide": "1.70.0",
    "mammoth": "1.13.0",
    "marked": "18.2.0",
    "pdfjs-dist": "6.5.438",
    "simplebar": "6.3.3",
    "tesseract.js": "7.0.0",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "gray-matter": "4.0.3",
    "handlebars": "4.7.10",
    "js-beautify": "2.0.3",
    "jsdom": "^31.0.0",
    "lefthook": "2.2.2",
    "lucide-static": "1.70.0",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "sharp": "^0.35.5",
    "vite": "8.3.6",
    "vite-plugin-handlebars": "2.0.3"
  },
  "allowScripts": {
    "lefthook": true
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "minimatch": "11.0.1",
    "glob": "14.0.3"
  }
}
