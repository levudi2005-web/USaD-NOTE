<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="{{ meta_description }}">
<meta name="author" content="{{ meta_author }}">
<meta name="keywords" content="{{ meta_keywords }}">

<link rel="icon" href="/img/note-logo.png" type="image/png" />

<meta name="theme-color" content="#f7f7fb" />

<title>{{#if title}}{{ title }} | {{/if}}{{ meta_title }}{{#unless title}} - {{ meta_slogan }}{{/unless}}</title>

<!-- Color mode before the first paint (src/js/head.js). Vite leaves vite-ignore tags as they are; vite.config.js builds the file. -->
<script src="js/head.js" vite-ignore></script>

<link href="/css/app.css" rel="stylesheet">
