<header class="note-topbar navbar navbar-expand px-3 border-bottom sticky-top" aria-label="Thanh công cụ NOTE">
  <button type="button" class="sidebar-toggle js-sidebar-toggle note-menu-toggle btn btn-sm btn-light border-0 me-3" aria-controls="sidebar" aria-expanded="true" aria-label="Thu gọn thanh điều hướng">
    <i class="hamburger align-self-center"></i>
  </button>

  <nav class="note-breadcrumb d-none d-md-flex align-items-center gap-2 small text-body-secondary me-3" aria-label="Đường dẫn">
    <a href="#dashboard" class="text-decoration-none text-body-secondary fw-semibold">NOTE</a>
    <i data-lucide="chevron-right" class="small"></i>
    <strong class="text-body fw-bold" data-breadcrumb>Tổng quan</strong>
  </nav>

  <div class="note-topbar-actions ms-auto d-flex align-items-center gap-2">
    <!-- Tìm kiếm toàn cục -->
    <div class="note-global-search-wrapper position-relative d-none d-sm-block">
      <label class="note-global-search d-flex align-items-center rounded-pill px-3 py-1 border bg-body-tertiary mb-0" style="width: 260px; height: 36px;">
        <i data-lucide="search" class="text-body-tertiary me-2" style="width: 16px; height: 16px;"></i>
        <input type="search" class="form-control form-control-sm border-0 bg-transparent p-0 shadow-none" placeholder="Tìm kiếm nhanh..." aria-label="Tìm kiếm toàn cục" data-global-search>
        <kbd class="badge bg-secondary-subtle text-secondary border small ms-auto fw-normal px-1 py-0" style="font-size: 10px;">Ctrl K</kbd>
      </label>
    </div>

    <!-- Quick Create Button -->
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 rounded-pill px-3 shadow-sm" type="button" data-note-create>
      <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
      <span class="d-none d-md-inline">Ghi chú</span>
    </button>

    <!-- Notifications Dropdown -->
    <div class="dropdown">
      <button class="btn btn-light btn-sm rounded-circle p-2 position-relative border" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thông báo">
        <i data-lucide="bell" style="width: 16px; height: 16px;"></i>
        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" data-notification-badge>
          <span class="visually-hidden">Thông báo mới</span>
        </span>
      </button>
      <div class="dropdown-menu dropdown-menu-end shadow border p-0" style="width: 320px;" aria-labelledby="notificationDropdown">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
          <h6 class="mb-0 fw-bold">Thông báo</h6>
          <button class="btn btn-link btn-sm p-0 text-decoration-none small" type="button" data-notification-mark-all>Đã đọc tất cả</button>
        </div>
        <div class="list-group list-group-flush small" data-notification-list style="max-height: 280px; overflow-y: auto;">
          <!-- Dynamically populated -->
        </div>
        <div class="p-2 border-top text-center bg-body-tertiary">
          <a href="#settings" class="small text-decoration-none fw-semibold" data-view-link="settings">Xem cài đặt thông báo</a>
        </div>
      </div>
    </div>

    <!-- Color Mode Dropdown -->
    <div class="dropdown">
      <button class="btn btn-light btn-sm rounded-circle p-2 border" type="button" id="themeDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Đổi giao diện" data-color-mode-toggle>
        <span data-color-mode-icon="light" hidden><i data-lucide="sun" style="width: 16px; height: 16px;"></i></span>
        <span data-color-mode-icon="dark" hidden><i data-lucide="moon" style="width: 16px; height: 16px;"></i></span>
        <span data-color-mode-icon="auto"><i data-lucide="sun-moon" style="width: 16px; height: 16px;"></i></span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow border" aria-labelledby="themeDropdown">
        <li>
          <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-color-mode-value="light">
            <i data-lucide="sun"></i> Sáng (Light Mode)
          </button>
        </li>
        <li>
          <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-color-mode-value="dark">
            <i data-lucide="moon"></i> Tối (Dark Mode)
          </button>
        </li>
        <li>
          <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-color-mode-value="auto">
            <i data-lucide="sun-moon"></i> Tự động (Theo hệ điều hành)
          </button>
        </li>
      </ul>
    </div>

    <!-- User Account Dropdown -->
    <div class="dropdown ms-1">
      <button class="btn btn-light btn-sm d-flex align-items-center gap-2 rounded-pill p-1 pe-2 border" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu tài khoản">
        <span class="note-user-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 13px;">N</span>
        <span class="small fw-semibold d-none d-lg-inline" data-user-profile-name-short>Người dùng</span>
        <i data-lucide="chevron-down" style="width: 14px; height: 14px;" class="text-body-tertiary"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow border py-2" aria-labelledby="userMenuDropdown" style="min-width: 220px;">
        <li class="px-3 py-2 border-bottom">
          <div class="fw-bold text-truncate" data-user-profile-name>Người dùng</div>
          <small class="text-body-secondary d-block text-truncate" data-user-profile-email></small>
        </li>
        <li>
          <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="#settings" data-view-link="settings">
            <i data-lucide="user"></i> Hồ sơ cá nhân
          </a>
        </li>
        <li>
          <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="#settings" data-view-link="settings">
            <i data-lucide="key"></i> Kết nối AI (BYOK)
          </a>
        </li>
        <li>
          <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="#settings" data-view-link="settings">
            <i data-lucide="hard-drive"></i> Quản lý bộ nhớ
          </a>
        </li>
        <li><hr class="dropdown-divider my-1"></li>
        <li>
          <button class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger" type="button" data-action-reset-cache>
            <i data-lucide="refresh-cw"></i> Làm mới bộ nhớ đệm
          </button>
        </li>
      </ul>
    </div>
  </div>
</header>
