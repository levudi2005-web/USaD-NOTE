<div class="note-app" id="note-app">
  <!-- 1. TỔNG QUAN (DASHBOARD) -->
  <section class="note-view note-dashboard-view" data-view-panel="dashboard">
    <div class="note-page-header">
      <div>
        <p class="text-uppercase small text-body-secondary fw-bold mb-1" data-today-label></p>
        <h1 class="h2 fw-bold mb-1">Chào bạn, hôm nay bạn muốn khám phá điều gì?</h1>
        <p class="text-body-secondary">Quản lý tài liệu thông minh, tích hợp AI và ôn tập kiến thức hiệu quả.</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-primary d-flex align-items-center gap-2" type="button" data-note-create>
          <i data-lucide="plus"></i> Ghi chú mới
        </button>
        <button class="btn btn-outline-secondary d-flex align-items-center gap-2" type="button" data-file-picker>
          <i data-lucide="upload"></i> Tải tài liệu
        </button>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-3 mb-4" aria-label="Thống kê tổng quan">
      <div class="col-6 col-lg-2 col-md-4">
        <div class="card border-0 shadow-sm h-100 p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-body-secondary small fw-medium">Tài liệu</span>
            <span class="p-2 rounded bg-info-subtle text-info"><i data-lucide="book-open" style="width:18px;height:18px"></i></span>
          </div>
          <h3 class="fw-bold mb-0" data-stat="documents">0</h3>
          <small class="text-body-tertiary mt-1" style="font-size:11px">Trong thư viện</small>
        </div>
      </div>
      <div class="col-6 col-lg-2 col-md-4">
        <div class="card border-0 shadow-sm h-100 p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-body-secondary small fw-medium">Lưu trữ</span>
            <span class="p-2 rounded bg-warning-subtle text-warning"><i data-lucide="hard-drive" style="width:18px;height:18px"></i></span>
          </div>
          <h3 class="fw-bold mb-0" data-stat="storage-used">0 B</h3>
          <small class="text-body-tertiary mt-1" style="font-size:11px">Tổng dung lượng tài liệu</small>
        </div>
      </div>
      <div class="col-6 col-lg-2 col-md-4">
        <div class="card border-0 shadow-sm h-100 p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-body-secondary small fw-medium">Bộ Flashcards</span>
            <span class="p-2 rounded bg-success-subtle text-success"><i data-lucide="layers" style="width:18px;height:18px"></i></span>
          </div>
          <h3 class="fw-bold mb-0" data-stat="decks">0</h3>
          <small class="text-body-tertiary mt-1" style="font-size:11px"><span data-stat="due-cards">0</span> thẻ cần ôn</small>
        </div>
      </div>
      <div class="col-6 col-lg-2 col-md-4">
        <div class="card border-0 shadow-sm h-100 p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-body-secondary small fw-medium">Bài Quiz</span>
            <span class="p-2 rounded bg-primary-subtle text-primary"><i data-lucide="list-checks" style="width:18px;height:18px"></i></span>
          </div>
          <h3 class="fw-bold mb-0" data-stat="quizzes">0</h3>
          <small class="text-body-tertiary mt-1" style="font-size:11px">Trắc nghiệm ôn tập</small>
        </div>
      </div>
      <div class="col-6 col-lg-2 col-md-4">
        <div class="card border-0 shadow-sm h-100 p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-body-secondary small fw-medium">AI Usage</span>
            <span class="p-2 rounded bg-danger-subtle text-danger"><i data-lucide="sparkles" style="width:18px;height:18px"></i></span>
          </div>
          <h3 class="fw-bold mb-0" data-stat="ai-queries">—</h3>
          <small class="text-body-tertiary mt-1" style="font-size:11px">Chưa có thống kê</small>
        </div>
      </div>
      <div class="col-6 col-lg-2 col-md-4">
        <div class="card border-0 shadow-sm h-100 p-3">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-body-secondary small fw-medium">Tiến độ</span>
            <span class="p-2 rounded bg-purple-subtle text-purple"><i data-lucide="chart-pie" style="width:18px;height:18px"></i></span>
          </div>
          <h3 class="fw-bold mb-0"><span data-stat="progress">0</span>%</h3>
          <div class="progress mt-2" style="height: 4px;">
            <div class="progress-bar bg-success" role="progressbar" data-progress-bar style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Shortcuts -->
    <div class="card border-0 shadow-sm p-3 mb-4">
      <div class="d-flex align-items-center gap-3 overflow-x-auto pb-1">
        <button class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 border rounded-pill flex-shrink-0" type="button" data-view-button="library">
          <i data-lucide="book-open" class="text-primary"></i> <span>Mở thư viện tài liệu</span>
        </button>
        <button class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 border rounded-pill flex-shrink-0" type="button" data-view-button="archives">
          <i data-lucide="archive" class="text-warning"></i> <span>Quản lý gói ZIP/7Z</span>
        </button>
        <button class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 border rounded-pill flex-shrink-0" type="button" data-view-button="assistant">
          <i data-lucide="sparkles" class="text-success"></i> <span>Hỏi đáp AI Assistant</span>
        </button>
        <button class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 border rounded-pill flex-shrink-0" type="button" data-view-button="ai-context">
          <i data-lucide="cpu" class="text-info"></i> <span>Mở AI Context Capsule</span>
        </button>
        <button class="btn btn-light d-flex align-items-center gap-2 px-3 py-2 border rounded-pill flex-shrink-0" type="button" data-view-button="flashcards">
          <i data-lucide="layers" class="text-danger"></i> <span>Ôn luyện Flashcard</span>
        </button>
      </div>
    </div>

    <!-- Main Dashboard Grid -->
    <div class="row g-4">
      <!-- Cột trái: Tài liệu vừa mở & Ghi chú gần đây -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom d-flex align-items-center justify-content-between py-3">
            <div>
              <h5 class="fw-bold mb-0">Tài liệu vừa mở</h5>
              <small class="text-body-secondary">Truy cập nhanh tài liệu trong không gian</small>
            </div>
            <a href="#library" class="btn btn-sm btn-outline-secondary" data-view-link="library">Xem thư viện <i data-lucide="arrow-right" class="small"></i></a>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush" data-dashboard-documents>
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom d-flex align-items-center justify-content-between py-3">
            <div>
              <h5 class="fw-bold mb-0">Ghi chú gần đây</h5>
              <small class="text-body-secondary">Tiếp tục suy nghĩ và liên kết kiến thức</small>
            </div>
            <a href="#notes" class="btn btn-sm btn-outline-secondary" data-view-link="notes">Tất cả ghi chú <i data-lucide="arrow-right" class="small"></i></a>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush" data-dashboard-notes>
              <!-- Populated by JS -->
            </div>
          </div>
        </div>
      </div>

      <!-- Cột phải: Kế hoạch & Hoạt động gần đây -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom d-flex align-items-center justify-content-between py-3">
            <div>
              <h5 class="fw-bold mb-0">Kế hoạch hôm nay</h5>
              <small class="text-body-secondary">Mục tiêu ôn luyện</small>
            </div>
            <button class="btn btn-sm btn-primary" type="button" data-task-create><i data-lucide="plus"></i> Thêm</button>
          </div>
          <div class="card-body">
            <div data-dashboard-tasks></div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="fw-bold mb-0">Hoạt động gần đây</h5>
            <small class="text-body-secondary">Nhật ký thao tác trên thiết bị</small>
          </div>
          <div class="card-body">
            <div class="note-activity-list" data-activity-list></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THƯ VIỆN TÀI LIỆU (LIBRARY) -->
  <section class="note-view" data-view-panel="library" data-document-library hidden>
    <div class="note-page-header">
      <div>
        <p class="text-uppercase small text-body-secondary fw-bold mb-1">TÀI NGUYÊN</p>
        <h1 class="h2 fw-bold mb-1">Thư viện tài liệu</h1>
        <p class="text-body-secondary">Đọc, trích xuất và quản lý đa định dạng: PDF, DOCX, XLSX, PPTX, EPUB, TXT, Ảnh.</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-primary d-flex align-items-center gap-2" type="button" data-file-picker>
          <i data-lucide="upload"></i> Tải tài liệu
        </button>
        <button class="btn btn-outline-secondary d-flex align-items-center gap-2" type="button" data-create-folder-trigger>
          <i data-lucide="folder-plus"></i> Thư mục mới
        </button>
      </div>
    </div>

    <!-- Dropzone Area -->
    <div class="note-panel note-dropzone mb-4" data-dropzone tabindex="0" role="button" aria-label="Kéo thả hoặc chọn tệp tài liệu">
      <input type="file" class="visually-hidden" data-file-input accept=".pdf,.docx,.xlsx,.xls,.csv,.pptx,.epub,.txt,.md,.markdown,.png,.jpg,.jpeg,.webp,.bmp,application/pdf,text/plain,image/png,image/jpeg,image/webp,image/bmp" multiple>
      <span class="note-drop-icon"><i data-lucide="file-up"></i></span>
      <strong>Kéo thả tài liệu vào đây để đưa vào kho tri thức</strong>
      <span>hoặc <button class="btn btn-link p-0 text-decoration-none fw-bold" type="button" data-file-picker>duyệt tệp từ máy tính</button></span>
      <small class="text-body-secondary">PDF, DOCX, XLSX, PPTX, EPUB, TXT, Markdown, PNG/JPG · Xử lý bảo mật trên trình duyệt</small>
    </div>

    <div class="note-document-status alert alert-info mb-4" data-document-status role="status" aria-live="polite" hidden></div>

    <!-- Toolbar: Search, Filter, Sort, Layout Switcher -->
    <div class="card border-0 shadow-sm p-3 mb-4">
      <div class="row g-2 align-items-center">
        <div class="col-md-5">
          <div class="input-group">
            <span class="input-group-text bg-body-tertiary border-end-0"><i data-lucide="search" style="width:16px;height:16px"></i></span>
            <input type="search" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên tài liệu..." aria-label="Tìm tài liệu" data-document-search>
          </div>
        </div>
        <div class="col-md-3">
          <select class="form-select" aria-label="Lọc loại tài liệu" data-document-type>
            <option value="">Tất cả định dạng</option>
            <option value="pdf">PDF Document</option>
            <option value="docx">Microsoft Word (DOCX)</option>
            <option value="xlsx">Bảng tính (XLSX, CSV)</option>
            <option value="pptx">PowerPoint (PPTX)</option>
            <option value="epub">Sách điện tử (EPUB)</option>
            <option value="txt">Văn bản (TXT, MD)</option>
            <option value="image">Hình ảnh / OCR</option>
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" aria-label="Lọc thư mục" data-document-folder-filter>
            <option value="">Tất cả thư mục</option>
          </select>
        </div>
        <div class="col-md-2 text-end">
          <div class="btn-group" role="group" aria-label="Kiểu hiển thị">
            <button type="button" class="btn btn-outline-secondary active" data-library-layout="list" title="Dạng danh sách"><i data-lucide="list"></i></button>
            <button type="button" class="btn btn-outline-secondary" data-library-layout="grid" title="Dạng lưới"><i data-lucide="layout-grid"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Multi-select Bulk Actions Bar (Floating) -->
    <div class="note-floating-actions" data-bulk-actions-bar hidden>
      <span class="small fw-semibold"><span data-bulk-count>0</span> mục đã chọn</span>
      <button class="btn btn-sm btn-outline-primary" type="button" data-bulk-add-context><i data-lucide="cpu"></i> Thêm vào AI Context</button>
      <button class="btn btn-sm btn-outline-secondary" type="button" data-bulk-move-folder><i data-lucide="folder-input"></i> Di chuyển</button>
      <button class="btn btn-sm btn-outline-danger" type="button" data-bulk-delete><i data-lucide="trash"></i> Xóa</button>
      <button class="btn btn-sm btn-light" type="button" data-bulk-cancel><i data-lucide="x"></i> Bỏ chọn</button>
    </div>

    <!-- Library Content Layout -->
    <div class="note-library-layout">
      <div class="note-panel note-document-list" data-document-list></div>
      <article class="note-panel note-document-preview" data-document-preview>
        <div class="note-empty-state">
          <span class="note-empty-icon"><i data-lucide="file-text"></i></span>
          <h2>Chọn tài liệu để xem</h2>
          <p>Tài liệu được xử lý cục bộ trên thiết bị của bạn. Hỗ trợ xem trực tiếp, tìm kiếm và trích xuất.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- 3. THƯ MỤC (FOLDERS) -->
  <section class="note-view" data-view-panel="folders" hidden>
    <div class="note-page-header">
      <div>
        <p class="text-uppercase small text-body-secondary fw-bold mb-1">CẤU TRÚC TRI THỨC</p>
        <h1 class="h2 fw-bold mb-1">Thư mục</h1>
        <p class="text-body-secondary">Tổ chức tài liệu và ghi chú theo hệ thống phân cấp logic.</p>
      </div>
      <button class="btn btn-primary d-flex align-items-center gap-2" type="button" data-create-folder-trigger>
        <i data-lucide="folder-plus"></i> Tạo thư mục
      </button>
    </div>

    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-3">
          <h6 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
            <span>Cây thư mục</span>
            <small class="text-body-secondary fw-normal">Phân cấp</small>
          </h6>
          <div class="list-group list-group-flush" data-folder-tree-list></div>
        </div>
      </div>
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4">
          <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div>
              <h5 class="fw-bold mb-0" data-folder-current-name>Tất cả tài liệu & thư mục</h5>
              <small class="text-body-secondary" data-folder-current-count>0 mục</small>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-outline-secondary" type="button" data-folder-rename-btn><i data-lucide="square-pen"></i> Đổi tên</button>
              <button class="btn btn-sm btn-outline-danger" type="button" data-folder-delete-btn><i data-lucide="trash"></i> Xóa thư mục</button>
            </div>
          </div>
          <div class="row g-3" data-folder-items-grid>
            <!-- Items populated by JS -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. BỘ SƯU TẬP (COLLECTIONS) -->
  <section class="note-view" data-view-panel="collections" hidden>
    <div class="note-page-header">
      <div>
        <p class="text-uppercase small text-body-secondary fw-bold mb-1">CHỦ ĐỀ & DỰ ÁN</p>
        <h1 class="h2 fw-bold mb-1">Bộ sưu tập</h1>
        <p class="text-body-secondary">Gom nhóm đa chiều: liên kết tài liệu, ghi chú và bộ thẻ vào cùng một chuyên đề.</p>
      </div>
      <button class="btn btn-primary d-flex align-items-center gap-2" type="button" data-create-collection-trigger>
        <i data-lucide="folder-heart"></i> Tạo bộ sưu tập
      </button>
    </div>

    <div class="row g-4" data-collections-grid>
      <!-- Populated by JS -->
    </div>
  </section>

  <!-- 5. ZIP / 7Z MANAGER (CHỨC NĂNG CHÍNH THỨC) -->
  <section class="note-view" data-view-panel="archives" hidden>
    <div class="note-page-header">
      <div>
        <div class="d-flex align-items-center gap-2">
          <h1 class="h2 fw-bold mb-0">Quản lý gói nén ZIP / 7Z</h1>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Core Feature</span>
        </div>
        <p class="text-body-secondary mt-1">Duyệt cây thư mục bên trong file nén, kiểm tra an toàn và trích xuất trực tiếp vào Thư viện tài liệu.</p>
      </div>
      <button class="btn btn-primary d-flex align-items-center gap-2" type="button" data-archive-picker-trigger>
        <i data-lucide="file-archive"></i> Tải gói ZIP / 7Z
      </button>
    </div>

    <!-- Drag & Drop Archive Zone -->
    <div class="note-panel note-dropzone mb-4" data-archive-dropzone tabindex="0" role="button" aria-label="Tải lên tệp ZIP hoặc 7Z">
      <input type="file" class="visually-hidden" data-archive-input accept=".zip,.7z,application/zip,application/x-7z-compressed" multiple>
      <span class="note-drop-icon"><i data-lucide="archive"></i></span>
      <strong>Thêm gói nén ZIP hoặc 7Z vào hệ thống</strong>
      <span>hoặc <button class="btn btn-link p-0 text-decoration-none fw-bold" type="button" data-archive-picker-trigger>chọn từ máy tính</button></span>
      <small class="text-body-secondary">Tự động phân tích cây thư mục nội bộ và kiểm tra mã độc an toàn (ngăn thực thi file .exe, .bat, .sh)</small>
    </div>

    <div class="row g-4">
      <!-- Cột trái: Danh sách các gói nén -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-3 h-100">
          <h6 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
            <span>Danh sách gói nén</span>
            <small class="text-body-secondary fw-normal" data-archive-count>0 gói</small>
          </h6>
          <div class="list-group list-group-flush" data-archive-list style="max-height: 520px; overflow-y: auto;">
            <!-- Populated by JS -->
          </div>
        </div>
      </div>

      <!-- Cột phải: Chi tiết gói nén, cây thư mục & công cụ trích xuất -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4" data-archive-detail-card>
          <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div>
              <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold mb-0" data-arch-title>Chọn một gói nén để xem</h5>
                <span class="badge bg-success-subtle text-success" data-arch-safe-badge><i data-lucide="shield-check" style="width:12px;height:12px"></i> An toàn</span>
              </div>
              <small class="text-body-secondary" data-arch-meta>Dung lượng &bull; Số lượng tệp &bull; Ngày tải</small>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-outline-primary" type="button" data-arch-download-btn><i data-lucide="download"></i> Tải lại</button>
              <button class="btn btn-sm btn-primary" type="button" data-arch-extract-all-btn><i data-lucide="folder-output"></i> Giải nén tất cả</button>
              <button class="btn btn-sm btn-outline-danger" type="button" data-arch-remove-btn><i data-lucide="trash"></i> Xóa</button>
            </div>
          </div>

          <!-- Tree View & File List Tabs -->
          <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#arch-tree-tab" type="button"><i data-lucide="folder-tree"></i> Cây thư mục</button>
            </li>
            <li class="nav-item">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#arch-files-tab" type="button"><i data-lucide="list"></i> Danh sách tệp chi tiết</button>
            </li>
            <li class="nav-item">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#arch-history-tab" type="button"><i data-lucide="clock"></i> Lịch sử giải nén</button>
            </li>
          </ul>

          <div class="tab-content">
            <!-- Cây thư mục -->
            <div class="tab-pane fade show active" id="arch-tree-tab">
              <div class="note-tree-container" data-arch-tree-container style="min-height: 280px; max-height: 400px; overflow-y: auto;">
                <p class="text-body-secondary small">Chưa có cây thư mục được chọn.</p>
              </div>
