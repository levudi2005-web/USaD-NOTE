          <div class="col-sm-6"><label class="form-label small fw-semibold">Đáp án D</label><input class="form-control" name="optionD" required></div>
        </div>
        <div class="row g-3">
          <div class="col-sm-4">
            <label class="form-label" for="quiz-answer-input">Đáp án đúng</label>
