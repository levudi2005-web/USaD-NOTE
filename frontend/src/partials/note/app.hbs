          <textarea class="form-control mb-3" id="share-description" rows="2" maxlength="1000" data-share-description></textarea>
          <label class="form-label" for="share-expiry">Thời hạn liên kết (tùy chọn)</label>
          <input class="form-control mb-3" id="share-expiry" type="datetime-local" data-share-expiry>
