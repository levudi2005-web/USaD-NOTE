<!-- Modal: Document Reader Zen Mode -->
<div class="modal fade" id="document-reader-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="note-reader-header">
        <div class="d-flex align-items-center gap-3">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal"><i data-lucide="arrow-left"></i> Thoát chế độ đọc</button>
          <h5 class="mb-0 fw-bold text-truncate" style="max-width: 400px;" data-reader-doc-title>Tài liệu</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="input-group input-group-sm" style="width: 220px;">
            <input type="search" class="form-control" placeholder="Tìm trong tài liệu..." data-reader-search-input>
            <span class="input-group-text small" data-reader-search-count>0/0</span>
          </div>
          <button class="btn btn-sm btn-outline-secondary" type="button" data-reader-zoom="-0.1" title="Thu nhỏ"><i data-lucide="minus"></i></button>
          <button class="btn btn-sm btn-outline-secondary" type="button" data-reader-zoom="0.1" title="Phóng to"><i data-lucide="plus"></i></button>
          <button class="btn btn-sm btn-outline-secondary" type="button" data-reader-toggle-toc title="Bật/Tắt Mục lục"><i data-lucide="list"></i></button>
          <button class="btn btn-sm btn-outline-primary" type="button" data-reader-toggle-ai title="Bật/Tắt AI Reading Assistant"><i data-lucide="sparkles"></i> AI Assistant</button>
        </div>
      </div>
      <div class="note-reader-body">
        <aside class="note-reader-toc" data-reader-toc-pane>
          <h6 class="fw-bold mb-3">Mục lục tài liệu</h6>
          <div data-reader-toc-list class="small">Chưa có mục lục phân tích.</div>
        </aside>
        <main class="note-reader-main" data-reader-content-pane>
          <!-- Document Content Rendered -->
        </main>
        <aside class="note-reader-ai-pane" data-reader-ai-pane>
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h6 class="fw-bold mb-0 d-flex align-items-center gap-2"><i data-lucide="sparkles" class="text-primary"></i> AI Reading Assistant</h6>
          </div>
          <div class="d-grid gap-2 mb-3">
            <button class="btn btn-sm btn-light border text-start" type="button" data-ai-reader-action="summarize-page"><i data-lucide="file-text"></i> Tóm tắt trang hiện tại</button>
            <button class="btn btn-sm btn-light border text-start" type="button" data-ai-reader-action="explain-terms"><i data-lucide="lightbulb"></i> Giải thích các thuật ngữ chính</button>
            <button class="btn btn-sm btn-light border text-start" type="button" data-ai-reader-action="extract-cards"><i data-lucide="layers"></i> Trích xuất câu hỏi ôn tập</button>
          </div>
          <div class="p-3 bg-body-tertiary rounded small" data-ai-reader-response style="min-height: 200px;">
            Nhấp chọn một tác vụ ở trên để trợ lý AI phân tích đoạn văn bản đang đọc.
          </div>
        </aside>
      </div>
    </div>
  </div>
</div>

