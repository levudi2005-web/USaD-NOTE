        <div class="row g-2 mb-3">
          <div class="col-sm-6"><label class="form-label small fw-semibold">Đáp án A</label><input class="form-control" name="optionA" required></div>
          <div class="col-sm-6"><label class="form-label small fw-semibold">Đáp án B</label><input class="form-control" name="optionB" required></div>
