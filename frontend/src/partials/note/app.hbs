          <label class="form-check mb-2"><input class="form-check-input" type="checkbox" data-share-clear-password><span class="form-check-label small">Gỡ mật khẩu hiện tại</span></label>
          <label class="form-check mb-2"><input class="form-check-input" type="checkbox" data-share-download><span class="form-check-label small">Cho phép người nhận tải xuống tệp gốc</span></label>
          <label class="form-check mb-3" data-share-consent-row><input class="form-check-input" type="checkbox" data-share-consent><span class="form-check-label small text-body-secondary">Tôi xác nhận chia sẻ tài liệu này.</span></label>
          <div class="note-share-link mb-3" data-share-link-row hidden>
            <div class="input-group">
              <input class="form-control" type="url" readonly aria-label="Liên kết chia sẻ" data-share-link>
              <button class="btn btn-outline-secondary" type="button" data-share-copy><i data-lucide="copy"></i> Chép link</button>
            </div>
          </div>
          <div class="note-share-actions d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="button" data-share-create hidden disabled>Tạo liên kết</button>
            <button class="btn btn-primary" type="button" data-share-update hidden>Lưu tùy chọn</button>
            <button class="btn btn-outline-secondary" type="button" data-share-rotate hidden>Tạo lại link</button>
            <button class="btn btn-outline-danger" type="button" data-share-revoke hidden>Thu hồi</button>
          </div>
        </section>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

